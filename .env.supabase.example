# ==============================================================================
# Supabase Cloud Database Configuration (Shared Pooler)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env.supabase' in the project root:
#      copy .env.supabase.example .env.supabase
# 2. Fill in the values from your Supabase Dashboard:
#      Go to: https://supabase.com/dashboard -> Select Project -> Project Settings -> Database
#      Under "Connection string" -> select "URI" or "Parameters" (Shared Pooler)
# 3. NEVER commit your actual '.env.supabase' file containing secrets to git!
# ==============================================================================

# Supabase Shared Pooler Host
# Example: aws-0-ap-south-1.pooler.supabase.com or aws-0-us-east-1.pooler.supabase.com
SUPABASE_HOST=aws-0-[REGION].pooler.supabase.com

# Supabase Shared Pooler Port
# - 6543: Transaction Mode (Recommended for Shared Pooler / serverless queries)
# - 5432: Session Mode (Recommended for DDL migrations and long transactions)
SUPABASE_PORT=6543

# Database Name (Supabase default is always 'postgres')
SUPABASE_DATABASE=postgres

# Database Username
# IMPORTANT: When connecting via the Shared Pooler, username MUST include the project ref!
# Format: postgres.[YOUR-PROJECT-REF]
# Example: postgres.abcdefghijklmnopqrst
SUPABASE_USER=postgres.[PROJECT_REF]

# Database Password set during Supabase project creation
SUPABASE_PASSWORD=your_supabase_database_password_here

# SSL Mode: Supabase strictly requires SSL. Do not change to 'disable'.
SUPABASE_SSLMODE=require

