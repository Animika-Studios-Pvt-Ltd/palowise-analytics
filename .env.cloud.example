# ==============================================================================
# Lumos Cloud Automation Configuration & GitHub Secrets Reference
# ==============================================================================
# DO NOT commit real secrets to GitHub or version control.
# Add these variables as "Repository Secrets" in GitHub:
#   Repository Settings -> Secrets and variables -> Actions -> "New repository secret"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud PostgreSQL Credentials
# ------------------------------------------------------------------------------
# Host from Supabase Project Settings -> Database (Shared Pooler)
SUPABASE_HOST=aws-1-ap-southeast-1.pooler.supabase.com

# Pooler Port: 5432 (Session mode recommended for DDL/sync) or 6543 (Transaction)
SUPABASE_PORT=5432

# Database name (always 'postgres' in Supabase)
SUPABASE_DATABASE=postgres

# Username format: postgres.[PROJECT_REF]
SUPABASE_USER=postgres.[PROJECT_REF]

# Database password set during Supabase project creation
SUPABASE_PASSWORD=your_supabase_password_here

# SSL mode strictly required by Supabase
SUPABASE_SSLMODE=require

# ------------------------------------------------------------------------------
# 2. Microsoft Graph API Credentials (for Unattended OneDrive Access)
# ------------------------------------------------------------------------------
# Obtained from Azure Portal -> Microsoft Entra ID -> App Registrations
MS_GRAPH_TENANT_ID=your_azure_ad_tenant_id_here
MS_GRAPH_CLIENT_ID=your_azure_ad_app_client_id_here
MS_GRAPH_CLIENT_SECRET=your_azure_ad_app_client_secret_here

# User email (UPN) whose OneDrive contains the file
# Example: dheeraj@animikastudios.com or your OneDrive account email
ONEDRIVE_USER_PRINCIPAL_NAME=user@yourdomain.com

# Path to the file in OneDrive root
ONEDRIVE_FILE_PATH=lumos10.xlsx

