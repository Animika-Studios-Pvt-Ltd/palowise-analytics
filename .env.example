# ==============================================================================
# Palowise PostgreSQL Development Configuration
# ==============================================================================
# SAFETY NOTICE:
# - Connect ONLY to the local development database: palowise_integration_dev
# - NEVER set PG_DATABASE to the production database 'test_database'
# - Copy this file to .env and replace placeholders with your local credentials
# ==============================================================================

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=palowise_integration_dev
PG_USER=postgres
PG_PASSWORD=your_password_here
